#!/bin/bash

# omarchy:summary=Set the current background image or video
# omarchy:args=<path-to-media> | --monitor <name> <path-to-image|folder> | --monitor <name> --clear
# omarchy:examples=omarchy theme bg set ~/Pictures/background.png | omarchy theme bg set --monitor DP-1 ~/Pictures/portrait.png | omarchy theme bg set --monitor DP-1 ~/Pictures/ultrawide | omarchy theme bg set --monitor DP-1 --clear

usage() {
  echo "Usage: omarchy-theme-bg-set <path-to-media>" >&2
  echo "       omarchy-theme-bg-set --monitor <name> <path-to-image|folder>" >&2
  echo "       omarchy-theme-bg-set --monitor <name> --clear" >&2
  exit 1
}

is_image_path() {
  [[ ${1,,} =~ \.(jpg|jpeg|png|gif|bmp|webp)$ ]]
}

MONITOR=""
CLEAR=0

while (( $# > 0 )); do
  case "$1" in
  --monitor)
    (( $# >= 2 )) || usage
    MONITOR="$2"
    shift 2
    ;;
  --clear)
    CLEAR=1
    shift
    ;;
  *)
    break
    ;;
  esac
done

if [[ -n $MONITOR ]]; then
  # A monitor shows its own background instead of the shared one: an image, or
  # a folder whose files share their names with the theme's backgrounds, so
  # cycling backgrounds picks that monitor's version of each.
  MONITOR_BACKGROUNDS_PATH="$HOME/.local/state/omarchy/current/monitor-backgrounds"

  if [[ $MONITOR == */* || $MONITOR == .* ]]; then
    echo "Invalid monitor name: $MONITOR" >&2
    exit 1
  fi

  if (( CLEAR )); then
    rm -f "$MONITOR_BACKGROUNDS_PATH/$MONITOR"
  else
    [[ -n $1 ]] || usage
    BACKGROUND="$(realpath "$1")"

    if [[ ! -e $BACKGROUND ]]; then
      echo "File does not exist: $BACKGROUND" >&2
      exit 1
    fi

    # Videos play through OWE on every monitor at once.
    if [[ ! -d $BACKGROUND ]] && ! is_image_path "$BACKGROUND"; then
      echo "A monitor's own background must be an image or a folder of images: $1" >&2
      exit 1
    fi

    mkdir -p "$MONITOR_BACKGROUNDS_PATH"
    ln -nsf "$BACKGROUND" "$MONITOR_BACKGROUNDS_PATH/$MONITOR"
  fi

  omarchy-shell -q background refreshMonitors
else
  (( CLEAR == 0 )) || usage
  [[ -n $1 ]] || usage

  BACKGROUND="$(realpath "$1")"
  CURRENT_BACKGROUND_LINK="$HOME/.local/state/omarchy/current/background"

  if [[ ! -f $BACKGROUND ]]; then
    echo "File does not exist: $BACKGROUND" >&2
    exit 1
  fi

  # Create symlink to the new background media
  ln -nsf "$BACKGROUND" "$CURRENT_BACKGROUND_LINK"

  # Update the live shell background immediately when it is running. The
  # background plugin also polls this symlink, but IPC avoids the visible delay.
  omarchy-shell -q background set "$BACKGROUND"
fi
